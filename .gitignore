# --- AWT free repo: awt-theme ---

# Dependencies (Carbon icon / IBM Plex font packages, when installed locally)
/node_modules/

# AWT Premium implementation code must never live in this free repo.
# It belongs in the awt-premium repo. (See awt-stage-1-spec.md §6 "Build sequencing".)
/premium-staging/
**/premium-staging/

# OS / editor cruft
.DS_Store
*.log
/vendor/

# The WordPress.org distribution zip, rebuilt on demand by `npm run build:zip`.
# Never committed: it is derived from the tracked files, and a stale copy in the
# repo is worse than none — it looks like the artifact and is not.
/awt.zip

# Generated by scripts/release.js; regenerated at every release.
build/
