#: inc/style-variations.php:184
msgid "Light scope"
msgstr ""

#: inc/admin-settings-page.php:1590
#: inc/style-variations.php:185
msgid "Dark scope"
msgstr ""

#. translators: 1: passing pairings, 2: failing pairings
#: inc/admin-settings-page.php:1643
#, php-format
