#: inc/style-variations.php:184
msgid "Light scope"
msgstr ""

#: inc/admin-settings-page.php:1573
#: inc/style-variations.php:185
msgid "Dark scope"
msgstr ""

#. translators: 1: passing pairings, 2: failing pairings
#: inc/admin-settings-page.php:1626
#, php-format
msgid "%1$d pass · %2$d fail."
msgstr ""

#: inc/admin-settings-page.php:1636
msgid "Token & role"
