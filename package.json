{
	"name": "awt-theme",
	"version": "2026.09.36",
	"description": "AWT theme — Stage 1",
	"main": "index.js",
	"license": "GPL-3.0-or-later",
	"type": "commonjs",
	"scripts": {
		"check:premium": "bash scripts/check-no-premium.sh",
		"prepare": "husky",
		"lint:js": "eslint src scripts",
		"lint:md": "markdownlint-cli2",
		"lint:php": "vendor/bin/phpcs",
		"build:zip": "node scripts/build-zip.js",
		"check:foundation": "node scripts/check-foundation.js",
		"i18n:pot": "wp i18n make-pot . languages/awt.pot --exclude=build,tests,scripts,node_modules,vendor --domain=awt",
		"check:css": "node scripts/check-css.js",
		"report:carbon-overrides": "node scripts/report-carbon-overrides.js",
		"release:prepare": "node scripts/release.js",
		"release:publish": "node scripts/release-publish.js",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/themes/awt vendor/bin/phpunit",
		"test:php:update": "wp-env run tests-cli --env-cwd=wp-content/themes/awt -- bash -c 'UPDATE_SNAPSHOTS=1 vendor/bin/phpunit'",
		"build:assets": "node scripts/build-assets.js",
		"check:assets": "node scripts/check-assets-clean.js"
	},
	"dependencies": {
		"@carbon/icons": "^11.81.0",
		"@carbon/styles": "^1.107.0",
		"@ibm/plex-mono": "^1.1.0",
		"@ibm/plex-sans": "^1.1.0"
	},
	"devDependencies": {
		"@wordpress/env": "^10.0.0",
		"@wordpress/eslint-plugin": "^25.7.0",
		"eslint": "^9.39.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"markdownlint-cli2": "^0.23.0",
		"sass": "^1.101.0",
		"terser": "^5.51.2"
	},
	"lint-staged": {
		"src/**/*.js": "eslint",
		"scripts/**/*.js": "eslint",
		"*.php": "vendor/bin/phpcs",
		"*.md": "markdownlint-cli2"
	}
}
